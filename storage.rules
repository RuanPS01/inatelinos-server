// Regras do Cloud Storage do Inatelinos.
// Mesma barreira do Firestore: e-mail do Inatel + e-mail confirmado.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function userIsInatelino() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('[A-Za-z0-9._%+-]+@([A-Za-z0-9-]+[.])*inatel[.]br')
        && request.auth.token.email_verified == true;
    }

    match /{userId}/{imageId} {
      allow read, write: if userIsInatelino();
    }
  }
}
